[Unit]
Description=lp: the album kiosk
# A user unit: no root anywhere in the loop. The updater (lp.update) relaunches
# the app in place after switching ~/lp/current, and Restart=always covers a
# crash. The user's pipewire socket exists at boot only with lingering enabled:
#   sudo loginctl enable-linger <user>
After=pipewire.service pipewire-pulse.service
Wants=pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=%h/lp/current
ExecStart=%h/lp/venv/bin/python %h/lp/current/main.py -c %h/.config/lp/config.yml --no-open
Restart=always
RestartSec=5

# The release-install layout (see lp/update.py): code under releases/<tag>,
# everything that must survive an update beside it.
Environment=LP_HOME=%h/lp
Environment=LP_CACHE_DIR=%h/lp/cache
Environment=LP_DATA_DIR=%h/lp/data

# SDL direct rendering without X (a screen wired to the board, no desktop).
# Remove this line to run the kiosk inside a desktop session instead.
Environment=SDL_VIDEODRIVER=kmsdrm

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lp

[Install]
WantedBy=default.target
